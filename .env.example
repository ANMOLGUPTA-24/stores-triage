# ---- Postgres (docker compose brings this up locally) ----
POSTGRES_USER=stores
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stores
DATABASE_URL=postgresql://stores:change_me@localhost:5433/stores

# ---- stores-mcp: our HTTP MCP server over the seeded schema ----
STORES_MCP_HOST=0.0.0.0
STORES_MCP_PORT=8081
# Static bearer token TrueForge sends as a header on every MCP request.
STORES_MCP_TOKEN=change_me

# ---- Vendor mail (the irreversible action) ----
# SMTP account you control. Gmail: use an App Password, not your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=change_me
# Synthetic vendor inbox - a mailbox you own. Never a real vendor.
VENDOR_MAIL_TO=you+vendor@example.com

# ---- Operator console -> TrueForge server ----
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=change_me

# Note: the Daytona sandbox key and your model provider key are configured
# inside TrueForge (Settings -> Sandbox / Models), not here.
